---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import { href } from '../lib/url';
---

<Base title="Page not found · Zoobia Saifullah" description="This page does not exist.">
  <section class="nf">
    <div class="container nf__inner">
      <span class="hand">oops!</span>
      <h1 class="h1">That page wandered off.</h1>
      <p class="lead">The link may be old or mistyped. Head back and keep exploring.</p>
      <a class="btn btn-primary" href={href('/')}>Back to home</a>
    </div>
  </section>
  <Footer />
</Base>

<style>
  .nf { padding-block: 168px 120px; }
  .nf__inner { display: flex; flex-direction: column; align-items: flex-start; gap: 16px; }
  .nf .hand { color: var(--primary); font-size: 28px; }
</style>
