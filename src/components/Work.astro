---
import ProjectCard from './ProjectCard.astro';
import { projects } from '../data/projects';

const [featured, ...rest] = projects;
---

<section class="work" id="work" aria-labelledby="work-title">
  <div class="container work__inner">
    <header class="work__head" data-reveal>
      <span class="eyebrow">Selected work</span>
      <h2 id="work-title" class="h2">Case studies</h2>
    </header>
    <div class="work__grid">
      <ProjectCard project={featured} featured index={0} />
      <div class="work__pair">
        {rest.map((p, i) => <ProjectCard project={p} index={i} />)}
      </div>
    </div>
  </div>
</section>

<style>
  .work { padding-block: 64px 96px; }
  .work__inner { display: flex; flex-direction: column; gap: 40px; }
  .work__head { display: flex; flex-direction: column; gap: 12px; }
  .work__grid { display: flex; flex-direction: column; gap: 24px; }
  .work__pair { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px; }
  @media (max-width: 1023px) { .work__pair { gap: 24px; } }
  @media (max-width: 767px) {
    .work { padding-block: 48px 64px; }
    .work__inner { gap: 28px; }
    .work__pair { grid-template-columns: 1fr; }
  }
</style>
