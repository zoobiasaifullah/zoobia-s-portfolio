---
import { research, site } from '../data/site';
---

<section class="research" id="research" aria-labelledby="research-title">
  <div class="container research__inner">
    <div class="research__main" data-reveal>
      <span class="eyebrow">{research.eyebrow}</span>
      <h2 id="research-title" class="h2">{research.title}</h2>
      <p class="lead">{research.body}</p>
      <ul class="chip-row" aria-label="Paper details">
        <li class="chip chip--accent">{research.venue}</li>
        <li class="chip">{research.role}</li>
      </ul>
      <a class="link-btn" href={site.links.paper} target="_blank" rel="noopener">
        Read the paper <span class="arrow" aria-hidden="true">→</span><span class="sr-only">(opens in a new tab)</span>
      </a>
    </div>

    <dl class="research__stats">
      {
        research.highlights.map((h, i) => (
          <div class="card stat" data-reveal style={`--i:${i + 1}`}>
            <dt class="stat__value">{h.value}</dt>
            <dd class="stat__label">{h.label}</dd>
          </div>
        ))
      }
    </dl>

    <div class="research__exploring">
      <h3 class="h4" data-reveal>Currently exploring</h3>
      <ul class="research__cols">
        {
          research.exploring.map((e, i) => (
            <li class="tile explore" data-reveal style={`--i:${i}`}>
              <h4 class="h4">{e.title}</h4>
              <p>{e.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .research { background: var(--section-alt); padding-block: 96px; }
  .research__inner { display: flex; flex-direction: column; gap: 48px; }
  .research__main { display: flex; flex-direction: column; align-items: flex-start; gap: 16px; max-width: 800px; }
  .research__stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; margin: 0; }
  .stat { display: flex; flex-direction: column; gap: 8px; padding: 32px; margin: 0; }
  .stat__value { font-size: 48px; line-height: 56px; font-weight: 600; letter-spacing: -0.04em; color: var(--primary); }
  .stat__label { margin: 0; }
  .research__exploring { display: flex; flex-direction: column; gap: 20px; }
  .research__cols { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
  .explore { display: flex; flex-direction: column; gap: 8px; padding: 28px; }

  @media (max-width: 1023px) { .research__stats { grid-template-columns: 1fr; gap: 16px; } .stat { padding: 24px; } }
  @media (max-width: 767px) {
    .research { padding-block: 64px; }
    .research__inner { gap: 36px; }
    .stat__value { font-size: 40px; line-height: 48px; }
    .research__cols { grid-template-columns: 1fr; gap: 16px; }
  }
</style>
